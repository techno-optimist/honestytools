__pycache__/
*.pyc
# third-party corpora fetched by nulltest_audit.py. NEVER committed: the audit records a URL
# and a sha256, not a copy of someone else's data. See NOTICE.
audit_cache/

# python build artifacts
*.egg-info/
build/
dist/
dossier_cache/
# matched subsets of third-party corpora are redistributions and stay out of the repository;
# the certificate and the subsets of our own batteries are committed
matched/*.json
!matched/surface_match_results.json
!matched/aperture_*.json

# witness client local state (attempt log, cosigned checkpoints); keep a backup, do not commit
witness/state/
